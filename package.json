{
	"name": "sentrygate",
	"private": true,
	"description": "Dev-/CI-Tooling für Wiedenroth Technologies SentryGate (wp-env, Playwright, Release-ZIP).",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:cli": "wp-env run cli",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"build:zip": "bash ./bin/build-release-zip.sh",
		"phpcs": "composer phpcs"
	},
	"devDependencies": {
		"@playwright/test": "1.49.1",
		"@wordpress/env": "10.39.0",
		"otpauth": "9.3.6"
	}
}
